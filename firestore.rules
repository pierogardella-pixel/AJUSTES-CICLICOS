rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'piero.gardella@ajiles.pe';
    }
    match /aje_public/{docId} {
      allow read: if docId == 'current';
      allow create, update: if docId == 'current' && isEditor();
      allow delete: if false;
    }
    match /aje_snapshots/{revision}/parts/{part} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if false;
    }
  }
}
